# Google Maps API Key
VITE_GOOGLE_MAPS_API_KEY=

# NASA FIRMS Map Key (server-side only).
# Injected by the dev proxy (vite.config.ts) and server/firmsProxy.ts at /api/firms.
# NEVER prefix with VITE_ — a VITE_ key is inlined into the public browser bundle.
NASA_FIRMS_MAP_KEY=

# DisasterWatch — live Firebase/Google backends.
# Without Firebase vars, the app runs in MOCK fallback mode (demo-safe).

# Firebase (Firestore + Auth + AI Logic). Get from Firebase Console → Project settings.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# App Check reCAPTCHA Enterprise site key (optional, recommended when enabling AI Logic).
# Must match src/lib/firebase/config.ts + workflow secret VITE_FIREBASE_APPCHECK_SITE_KEY.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Gemini model for Firebase AI Logic (optional).
# Default (src/lib/firebase/geminiConfig.ts): gemini-3.8-flash.
# Set only to switch to another supported model, e.g. VITE_GEMINI_MODEL=gemini-3.7-flash.
# Supported names: https://firebase.google.com/docs/ai-logic/models
# If the primary model is overloaded (HTTP 503), the app and /status checks
# automatically fall back to GEMINI_FALLBACK_MODELS (gemini-3.5-flash-lite).
# VITE_GEMINI_MODEL=

# Server-only Gemini Developer API key (fallback when AI Logic is blocked, e.g. App Check).
# Served by the server-side proxy (server/aiProxy.ts + Vite dev middleware) at
# POST /api/ai/generate. NEVER prefix with VITE_ — a VITE_ key is inlined into the
# public browser bundle. LOCAL ONLY — never commit.
# Backend key: restrict to the required API and server IPs where supported; never use browser referrer restrictions for a server credential.
GEMINI_API_KEY=

# Server/CI only. Do not prefix with VITE_.
ZAPI_API_KEY=
# Server/workflow only. Never prefix with VITE_. Requires approved Flood Forecasting API access.
GOOGLE_FLOOD_API_KEY=

# Server crawler only; never prefix these secrets with VITE_.
DISASTERWATCH_GOOGLE_SEARCH_ENABLED=false
DISASTERWATCH_GOOGLE_SEARCH_MODEL=gemini-3.8-flash
DISASTERWATCH_GEMINI_SEARCH_KEY=

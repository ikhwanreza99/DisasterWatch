// DisasterWatch Firestore rules — prototype baseline.
// - Authenticated (incl. anonymous) users may CREATE reports/aid.
// - Verification writes are server-only (Admin SDK); clients cannot self-approve.
// - Reads are open for demo dashboard; tighten for production.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Browser counts are self-reported telemetry, never billing evidence.
    // Server crawler writes use Admin SDK. Only superusers read usage.
    function usageCount(value) {
      return value == null || (value is int && value >= 0 && value <= 100000000);
    }
    match /aiUsage/{id} {
      allow read: if superuser();
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.keys().hasOnly(['at','createdAt','model','transport','source','uid','input','output','total'])
        && request.resource.data.keys().hasAll(['at','createdAt','model','transport','source','uid','input','output','total'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.source == 'browser'
        && request.resource.data.createdAt == request.time
        && request.resource.data.at is string && request.resource.data.at.size() <= 30
        && request.resource.data.model is string && request.resource.data.model.size() <= 100
        && request.resource.data.transport is string && request.resource.data.transport.size() <= 100
        && usageCount(request.resource.data.input) && usageCount(request.resource.data.output)
        && request.resource.data.total is int && request.resource.data.total >= 0 && request.resource.data.total <= 100000000;
      allow update, delete: if false;
    }
    match /users/{id} {
      allow read: if request.auth != null && (superuser() || resource.data.authUid == request.auth.uid);
      allow write: if false; // Provisioned Admin SDK only; clients cannot assign roles.
    }
    function superuser() {
      return request.auth != null && (request.auth.token.get('superuser', false) == true ||
        (get(/databases/$(database)/documents/users/admin).data.authUid == request.auth.uid
          && get(/databases/$(database)/documents/users/admin).data.role == 'SUPERUSER'
          && get(/databases/$(database)/documents/users/admin).data.accountStatus == 'ACTIVE'));
    }
    function evidenceValid(data) {
      return data.reviewedBy == request.auth.uid && data.reviewNote is string && data.reviewNote.size() >= 10 && data.reviewNote.size() <= 1000
        && data.evidenceUrls is list && data.evidenceUrls.size() >= 1 && data.evidenceUrls.size() <= 5
        && data.evidenceUrls[0] is string && data.evidenceUrls[0].matches('https://.*')
        && (data.evidenceUrls.size() < 2 || data.evidenceUrls[1].matches('https://.*'))
        && (data.evidenceUrls.size() < 3 || data.evidenceUrls[2].matches('https://.*'))
        && (data.evidenceUrls.size() < 4 || data.evidenceUrls[3].matches('https://.*'))
        && (data.evidenceUrls.size() < 5 || data.evidenceUrls[4].matches('https://.*'));
    }
    function audited(data, kind, id) {
      let audit = getAfter(/databases/$(database)/documents/reportReviews/$(data.reviewAuditId)).data;
      return evidenceValid(data) && audit.reviewedBy == request.auth.uid && audit.decision == 'APPROVED'
        && audit.reviewNote == data.reviewNote && audit.evidenceUrls == data.evidenceUrls
        && (kind == 'disasters' ? audit.disasterId == id : audit.targetCollection == kind && audit.targetId == id);
    }
    match /disasters/{id} {
      allow read: if true;
      allow create: if superuser() && request.resource.data.isMock == false && request.resource.data.demoNotice == 'REAL'
        && request.resource.data.id == id && request.resource.data.approvalStatus == 'APPROVED' && audited(request.resource.data, 'disasters', id);
      allow update: if superuser() && resource.data.get('isMock', false) == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvalStatus','reviewedBy','reviewedAt','reviewNote','evidenceUrls','reviewAuditId'])
        && request.resource.data.approvalStatus == 'APPROVED' && audited(request.resource.data, 'disasters', id);
      allow delete: if false;
    }
    match /reports/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.resource.data.reporterUid == request.auth.uid && request.resource.data.isMock == false
        && request.resource.data.keys().hasAll(['sourceType','rawText','location','createdAt'])
        && request.resource.data.rawText is string
        && request.resource.data.rawText.size() > 0
        && request.resource.data.rawText.size() < 4000
        && request.resource.data.verificationStatus in ['UNVERIFIED', 'AI_REVIEWED', 'CONFLICTING']
        && !request.resource.data.keys().hasAny(['reviewedBy', 'reviewedAt', 'reviewNote', 'evidenceUrls', 'reviewAuditId']);
      // Admin approval uses a protected server endpoint + Admin SDK transaction.
      allow update: if superuser() && resource.data.get('isMock', false) == false
        && resource.data.verificationStatus in ['UNVERIFIED', 'AI_REVIEWED', 'CONFLICTING']
        && request.resource.data.verificationStatus == 'VERIFIED'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verificationStatus','disasterId','reviewedBy','reviewedAt','reviewNote','evidenceUrls','reviewAuditId'])
        && audited(request.resource.data, 'reports', id);
      allow delete: if false;
    }
    match /reportReviews/{id} {
      allow read: if superuser();
      allow create: if superuser() && evidenceValid(request.resource.data) && request.resource.data.reviewAuditId == id
        && request.resource.data.decision == 'APPROVED'
        && request.resource.data.targetCollection in ['reports','disasters']
        && getAfter(/databases/$(database)/documents/disasters/$(request.resource.data.disasterId)).data.reviewAuditId == id;
      allow update, delete: if false;
    }
    match /aid/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.quantity is number
        && request.resource.data.quantity > 0;
      allow update, delete: if false;
    }
    match /needs/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /locations/{id} {
      allow read: if true;
      allow write: if false;
    }
    // NTT real-data case (additive; existing rules untouched).
    // Reads open for the dashboard; writes require auth + constrained fields.
    // Never accept isMock:true (real articles must never be overwritten by mock content).
    match /nttCases/{id} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.caseId is string
        && request.resource.data.isMock == false;
      allow delete: if false;
    }
    match /nttArticles/{id} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasAll(['caseId', 'title', 'url'])
        && request.resource.data.title is string
        && request.resource.data.url is string
        && request.resource.data.isMock == false;
      allow delete: if false;
    }
    match /nttClaims/{id} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasAll(['caseId', 'articleId', 'claimText', 'sourceUrl'])
        && request.resource.data.claimText is string
        && request.resource.data.sourceUrl is string;
      allow delete: if false;
    }
    // Humanitarian source-of-truth collections (additive; existing rules untouched).
    // Reads open for the dashboard. Writes are Admin-SDK-only (crawler/seed scripts
    // bypass rules with least-privilege IAM); client writes stay on the legacy
    // `aid`/`reports` collections above. No rule is loosened here.
    match /incidents/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /incidentArticles/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /incidentClaims/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /incidentAidNeeds/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /incidentAidEvents/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /incidentPoskos/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /incidentRecovery/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /incidentCrawlRuns/{id} {
      allow read: if true;
      allow write: if false;
    }
  }
}

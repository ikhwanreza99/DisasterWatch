// DisasterWatch Firestore rules — prototype baseline.
// - Authenticated (incl. anonymous) users may CREATE reports/aid.
// - Nobody may overwrite verified intelligence except via constrained fields.
// - Reads are open for demo dashboard; tighten for production.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /disasters/{id} {
      allow read: if true;
      allow write: if false; // seeded by admin only in prototype
    }
    match /reports/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['sourceType','rawText','location','createdAt'])
        && request.resource.data.rawText is string
        && request.resource.data.rawText.size() > 0
        && request.resource.data.rawText.size() < 4000;
      allow update: if request.auth != null
        && !(resource.data.verificationStatus == 'VERIFIED'
             && request.resource.data.verificationStatus != 'VERIFIED');
      allow delete: if false;
    }
    match /aid/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.quantity is number
        && request.resource.data.quantity > 0;
      allow update, delete: if false;
    }
    match /needs/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /locations/{id} {
      allow read: if true;
      allow write: if false;
    }
    // NTT real-data case (additive; existing rules untouched).
    // Reads open for the dashboard; writes require auth + constrained fields.
    // Never accept isMock:true (real articles must never be overwritten by mock content).
    match /nttCases/{id} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.caseId is string
        && request.resource.data.isMock == false;
      allow delete: if false;
    }
    match /nttArticles/{id} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasAll(['caseId', 'title', 'url'])
        && request.resource.data.title is string
        && request.resource.data.url is string
        && request.resource.data.isMock == false;
      allow delete: if false;
    }
    match /nttClaims/{id} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasAll(['caseId', 'articleId', 'claimText', 'sourceUrl'])
        && request.resource.data.claimText is string
        && request.resource.data.sourceUrl is string;
      allow delete: if false;
    }
    // Humanitarian source-of-truth collections (additive; existing rules untouched).
    // Reads open for the dashboard. Writes are Admin-SDK-only (crawler/seed scripts
    // bypass rules with least-privilege IAM); client writes stay on the legacy
    // `aid`/`reports` collections above. No rule is loosened here.
    match /incidents/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /incidentArticles/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /incidentClaims/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /incidentAidNeeds/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /incidentAidEvents/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /incidentPoskos/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /incidentRecovery/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /incidentCrawlRuns/{id} {
      allow read: if true;
      allow write: if false;
    }
  }
}
